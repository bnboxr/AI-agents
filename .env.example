# ===== REQUIRED =====
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# DeepSeek API key: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=sk-...

# Grok API key: https://x.ai
GROK_API_KEY=xai-...

# Gemini API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=...

# Wallet secret for autonomous trading (INVENT THIS — never share)
AUTONOMOUS_WALLET_SECRET=your_random_32_char_secret_here

# Starting capital in USD (how much agents can trade)
STARTING_CAPITAL=100

# ===== RECOMMENDED =====
# Bitunix API: https://bitunix.com/api
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# Alchemy/Infura RPC for Polygon
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Binance API (for market data)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ===== OPTIONAL =====
# POS Contract (after deploy)
VITE_POS_CONTRACT_ADDRESS=

# Stripe (for selling signals)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Database (Neon Postgres)
DATABASE_URL=

# Copy trading target wallets (comma separated)
COPY_TRADE_WALLETS=

# CoinGecko API (for free tier, leave empty)
COINGECKO_API_KEY=
