# ============================================================
# HSMC Platform — Environment Variables
# Copy to `.env` and fill in real values. Placeholders only.
# NEVER commit real secrets. Placeholder values are ignored at runtime.
# ============================================================

# ===== COMPUTATION / AI PROVIDERS =====
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# DeepSeek API key: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=sk-...
# Grok API key: https://x.ai
GROK_API_KEY=xai-...
# Gemini API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=...
# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ===== WALLET & CAPITAL =====
# Wallet secret for autonomous trading (INVENT THIS — never share).
# Required to derive/decrypt the autonomous wallet.
AUTONOMOUS_WALLET_SECRET=your_random_32_char_secret_here
# PAPER/SIMULATION starting capital in USDT (used ONLY by the simulation
# ledger in capital-manager / unified-balance; labelled "simulation", never
# presented as live funds). Leave unset for $0 (no fabricated paper capital).
STARTING_CAPITAL=
# If PAPER_BALANCES=true the paper/simulation ledger is enabled for the
# given modules. This is a simulation flag — it does NOT create real funds.
PAPER_BALANCES=false

# ===== EXCHANGE API KEYS (market data + real execution) =====
# Binance: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Bitunix: https://bitunix.com/api
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# ===== CHAIN RPC ENDPOINTS =====
# Polygon / Polygon Amoy (testnet)
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
POLYGON_AMOY_RPC_URL=
# EVM chains used by agents
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
# Solana (mainnet + devnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Other chains
XRP_RPC_URL=
XRP_TESTNET_RPC_URL=
TRON_RPC_URL=
TRON_SHASTA_RPC_URL=
COSMOS_RPC_URL=

# ===== AUTONOMOUS WALLET ADDRESSES =====
# Solana public key of the autonomous wallet (optional, derived if unset)
SOLANA_WALLET_PUBKEY=

# ===== AIRDROP FARMER =====
# Comma-separated funded wallet addresses to farm / claim airdrops with.
FARM_WALLETS=
# Private key of a FUNDED wallet used for real claim transactions (real funds
# move here — never fill with dummy/paper value).
FARMER_PRIVATE_KEY=
# Public address matching FARMER_PRIVATE_KEY.
FARMER_WALLET_ADDRESS=

# ===== POS TERMINAL (Polygon settlement) =====
# Owned POS wallet address that receives payment settlement.
VITE_POS_OWNER_ADDRESS=
# Polygon RPC used by the POS terminal for settlement verification.
VITE_POLYGON_RPC=
# Network name for POS settlement (e.g. "amoy" or "polygon").
VITE_POS_NETWORK=
# Deployed PaymentSettlement contract address (after real deploy).
VITE_POS_CONTRACT_ADDRESS=

# ===== SIGNALS (paywall) =====
# Premium signal subscribers (comma separated wallet/email addresses).
SIGNAL_PREMIUM_USERS=
# Real Stripe payment link for signal subscriptions (must be a LIVE link).
STRIPE_SIGNAL_LINK=
# Stripe secret key (for server-side paywall verification).
STRIPE_SECRET_KEY=
# Stripe publishable key (client-side).
VITE_STRIPE_PUBLISHABLE_KEY=

# ===== CONTRACT DEPLOY (hardhat) =====
# Only for deploying real contracts with a funded deployer key.
DEPLOY_NETWORK=
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
DEPLOY_CONTRACT=
DEPLOY_SINGLE_CONTRACT=
DEPLOYMENT_MODE=

# ===== DATABASE =====
# Neon Postgres connection string.
DATABASE_URL=

# ===== COPY TRADING =====
# Target wallets to mirror (comma separated).
COPY_TRADE_WALLETS=

# ===== COINGECKO =====
# CoinGecko API key (free tier can be left empty).
COINGECKO_API_KEY=

# ===== OPTIONAL / NETWORK TUNING =====
# Last price update interval for price cache (ms).
LAST_PRICE_UPDATE_MS=
# Gas parameters used by the gas optimizer.
GAS_PRICE_GWEI=
PRIORITY_FEE_GWEI=
FLASH_LOAN_MIN_PROFIT=
FLASH_LOAN_OWNER=
YIELD_OPTIMIZER_OWNER=
VAULT_OWNER=
CROSS_CHAIN_OWNER=
# Alchemy API key for default RPCs.
ALCHEMY_API_KEY=
